// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"context": "Workspace",
		"bindings": {
			"ctrl-]": "workspace::IncreaseActiveDockSize",
			"ctrl-[": "workspace::DecreaseActiveDockSize",

			"shift shift": "file_finder::Toggle",

			// "ctrl-{": "",
		},
	},

	{
		"context": "Editor && vim_mode == insert",
		"bindings": {
			// "j k": "vim::NormalBefore"
		},
	},

	{
		"context": "OutlinePanel && not_editing",
		"bindings": {
			"space": "outline_panel::OpenSelectedEntry",
		},
	},

	{
		"context": "Editor && vim_mode == normal",
		"bindings": {
			// "shift shift": "file_finder::Toggle",
			"space b": [
				"action::Sequence",
				[
					"workspace::CloseAllDocks",
					"workspace::ClearAllNotifications",
				],
			],
			"space p v": "project_panel::ToggleFocus",
			"space p g": "git_panel::ToggleFocus",
			"space p f": "workspace::NewSearch",
			"space p c": "workspace::CloseInactiveTabsAndPanes",

			// "[ b": "bedrock::TabPrev",
			// "] b": "bedrock::Tab",
		},
	},

	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"space": "project_panel::Open",
			"r": "project_panel::Rename",
			"enter": [
				"action::Sequence",
				["project_panel::Open", "workspace::ToggleLeftDock"],
			],
		},
	},
	{
		"context": "Editor",
		"bindings": {
			"ctrl-shift-]": null,
		},
	},
	{
		"context": "Editor",
		"bindings": {
			"ctrl-shift-[": null,
		},
	},
	{
		"bindings": {
			"ctrl-shift-]": "bedrock::Tab",
		},
	},
	{
		"bindings": {
			"ctrl-shift-[": "bedrock::TabPrev",
		},
	},
]
